# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Twilio Voice
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# App
APP_HOST=0.0.0.0
APP_PORT=8000
# Public URL for Twilio webhooks (use ngrok in dev: ngrok http 8000)
PUBLIC_BASE_URL=https://your-domain.com

# Bank Configuration
BANK_NAME=Shri Sahakar Cooperative Bank
BANK_PHONE=+91XXXXXXXXXX

# Call Settings (24-hour format, IST)
CALL_START_HOUR=9
CALL_END_HOUR=18
MAX_CALL_ATTEMPTS=3

# Database
DATABASE_URL=sqlite+aiosync:///./telecaller.db
